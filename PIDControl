//Included Packages
#include <PID_v1.h> 

//Defines & Constants
  //Define Variables we'll be connecting to 
double Setpoint, Input, Output; 
  //Specify the links and initial tuning parameters 
double Kp=2, Ki=5, Kd=1; //Values should be adjusted
PID myPID(&Input, &Output, &Setpoint, Kp, Ki, Kd, DIRECT); 

//User variables
  // Input of the train speed measured by the hall sensor 
int PIN_INPUT = 0 
  // output is passed to the motor speed in the function motorControl 
int PIN_OUTPUT = 3 

 
void setup() { 
  //initialize the variables we're linked to 
  Input = speed_to_duty_ratio * analogRead(PIN_INPUT); 
  // ideal speed in Radians per second, should be measured and an average taken for the train  
  Setpoint = 20; 
  //turn the PID on 
  myPID.SetMode(AUTOMATIC); 
} 

 
void loop() { 
  Input = speed_to_duty_ratio * analogRead(PIN_INPUT); 
  myPID.Compute(); 
  analogWrite(PIN_OUTPUT, Output); 
} 
